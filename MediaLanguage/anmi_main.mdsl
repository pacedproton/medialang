// Canonical entry point for the ANMI MediaLanguage representation.
//
// This file imports the normative layer only:
//   - vocabularies and code lists
//   - core entity unit definitions (Medienangebot, Medienunternehmen)
//   - relationship table schemas (diachronic, synchronous)
//   - market-data schemas
//   - the source/provenance catalog
//
// Bulk instance data (the ~657 outlets imported from the source database)
// lives in the generated artifact anmi_full_export.mdsl and is intentionally
// not imported here, so this entry point validates as a pure schema bundle.
//
// Curated, examples live alongside under media_groups/ and
// are validated independently from this entry point.

IMPORT "anmi_common_codes.mdsl";
IMPORT "anmi_media_sectors.mdsl";
IMPORT "anmi_mandate_types.mdsl";
IMPORT "anmi_source_references.mdsl";
IMPORT "anmi_market_data_schemas.mdsl";
IMPORT "Medienangebot.mdsl";
IMPORT "Medienunternehmen.mdsl";
IMPORT "MedienangeboteDiachroneBeziehungen.mdsl";
IMPORT "MedienangeboteSynchroneBeziehungen.mdsl";
IMPORT "MedienunternehmenSynchroneBeziehungenMitMedienangeboten.mdsl";
IMPORT "MedienunternehmenDiachroneBeziehungen.mdsl";
IMPORT "MedienunternehmenSynchroneBeziehungenMitAnderenUnternehmen.mdsl";
IMPORT "sources.mdsl";